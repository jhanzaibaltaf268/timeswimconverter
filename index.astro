<script define:vars={{ t }}>
  const clamp = (n, min, max) => Math.min(Math.max(n, min), max);

  function parseTimeToSeconds(str) {
    if (!str || typeof str !== "string") return NaN;
    const s = str.trim();
    if (!s) return NaN;
    const parts = s.split(":").map((p) => p.trim());
    const nums = parts.map((p) => Number(p));
    if (nums.some((n) => Number.isNaN(n))) return NaN;
    let sec = 0;
    if (parts.length === 3) sec = nums[0] * 3600 + nums[1] * 60 + nums[2];
    else if (parts.length === 2) sec = nums[0] * 60 + nums[1];
    else sec = nums[0];
    return sec;
  }

  function formatSeconds(t, decimals = 2) {
    if (!Number.isFinite(t)) return "—";
    if (t < 0) return `-${formatSeconds(-t, decimals)}`;
    const h = Math.floor(t / 3600);
    const mm = Math.floor((t % 3600) / 60);
    const ss = t % 60;
    const sFixed = ss.toFixed(decimals);
    const [sInt, sFrac] = sFixed.split(".");
    const two = String(sInt).padStart(2, "0");
    return h > 0
      ? `${h}:${String(mm).padStart(2, "0")}:${two}${decimals > 0 ? "." + sFrac : ""}`
