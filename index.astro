---
import IndexLayout, { getStaticPaths as getStaticPathsIndex } from '@theme/layouts/IndexLayout.astro';
import FAQs from '@theme/components/FAQs.astro';
import Chart from '@theme/components/Chart.astro';
import CalculatorToolsBanner from '@theme/components/CalculatorToolsBanner.astro';
import RelatedResources from '@theme/components/RelatedResources.astro';
import { getTranslations, type Locale } from '@theme/i18n/utils';

const locale = (Astro.params.lang || 'en') as Locale;
const t = getTranslations(locale);

export const getStaticPaths = getStaticPathsIndex;

const chartData: any[] = [];
---

<IndexLayout>
  <!-- Hero Section -->
  <div class="text-center mb-10 animate-fadeIn">
    <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold gradient-text mb-4">
      {t['Time Swim Converter']}
    </h1>
    <p class="text-white/60 text-lg max-w-2xl mx-auto">
      Free <strong class="text-white">swim time converter</strong> to convert SCY, SCM, and LCM swimming times in real-time. Calculate pool conversions for swimmers, coaches, and recruiters.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8">
    <!-- Main Converter Section -->
    <section class="lg:col-span-2 animate-slideInLeft" style="animation-delay: 0.1s;">
      <div class="glass-card p-6 md:p-8">
        <!-- Header with Decimals -->
        <header class="flex items-center justify-between gap-4 mb-6 flex-wrap">
          <div>
            <h2 class="text-xl font-semibold text-white">{t['Time Swim Converter']}</h2>
            <p class="text-sm text-white/50 mt-1">{t['SCY ⇄ SCM ⇄ LCM — event-aware and real-time.']}</p>
          </div>

          <div class="flex items-center gap-3">
            <label for="decimals" class="text-sm text-white/60 hidden sm:block">{t['Decimals']}</label>
            <select id="decimals" class="premium-select">
              <option value="0">0</option>
              <option value="1">1</option>
              <option value="2">2</option>
              <option value="3">3</option>
            </select>
          </div>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- From -->
          <div class="space-y-4">
            <label class="block text-sm font-medium text-ocean-400">{t['From course & event']}</label>
            <div class="grid grid-cols-2 gap-3">
              <select id="fromCourse" class="premium-select w-full">
                <option value="SCY">{t['SCY (25 yards)']}</option>
                <option value="SCM">{t['SCM (25 meters)']}</option>
                <option value="LCM">{t['LCM (50 meters)']}</option>
              </select>

              <select id="fromEvent" class="premium-select w-full"></select>
            </div>

            <div>
              <label class="block text-sm font-medium text-ocean-400 mb-2" for="timeIn">{t['Your time']}</label>
              <input
                id="timeIn"
                type="text"
                inputmode="decimal"
                value="1:00.00"
                placeholder={t['e.g., 59.50 or 1:05.23']}
                class="premium-input w-full text-xl mono"
              />
            </div>
            <p class="text-xs text-white/40">
              {t['Formats:']} <span class="mono text-ocean-400/70">{t['ss.hh']}</span>, <span class="mono text-ocean-400/70">{t['m:ss.hh']}</span>, {t['or']} <span class="mono text-ocean-400/70">{t['h:mm:ss.hh']}</span>
            </p>
          </div>

          <!-- To -->
          <div class="space-y-4">
            <label class="block text-sm font-medium text-ocean-400">{t['To course & event']}</label>
            <div class="grid grid-cols-2 gap-3">
              <select id="toCourse" class="premium-select w-full">
                <option value="SCY">{t['SCY (25 yards)']}</option>
                <option value="SCM">{t['SCM (25 meters)']}</option>
                <option value="LCM">{t['LCM (50 meters)']}</option>
              </select>

              <select id="toEvent" class="premium-select w-full"></select>
            </div>

            <label class="inline-flex items-center gap-3 text-sm text-white/70 select-none cursor-pointer group">
              <input id="matchNominal" type="checkbox" class="premium-checkbox" />
              <span class="group-hover:text-white/90 transition-colors">Match equivalent events (500y to 400m, 1650y to 1500m)</span>
            </label>

            <div class="flex items-center gap-3 pt-2">
              <button id="copyResult" class="premium-btn" type="button">
                <span class="flex items-center gap-2">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                  </svg>
                  {t['Copy result']}
                </span>
              </button>
              <button id="clearTime" class="premium-btn-danger" type="button">
                {t['Clear']}
              </button>
            </div>
          </div>
        </div>

        <!-- Advanced Settings -->
        <div class="mt-8 glass-card !bg-white/5 p-5 !rounded-xl">
          <div class="flex items-center justify-between gap-3 flex-wrap mb-4">
            <h3 class="font-semibold text-white">{t['Advanced: Per-wall advantage (seconds)']}</h3>
            <span class="text-xs text-white/50">{t['Adjust to match your turns & underwater skills']}</span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="glass-card !bg-white/5 p-4 !rounded-xl">
              <div class="text-xs text-ocean-400 font-medium mb-3">{t['SCY (25 yards)']}</div>
              <div class="flex items-center gap-3">
                <input id="wallSCY" type="range" min="0.2" max="1.0" step="0.01" value="0.55" class="premium-slider flex-1" />
                <div id="wallSCYVal" class="w-14 text-right mono text-sm text-white/80">0.55s</div>
              </div>
            </div>

            <div class="glass-card !bg-white/5 p-4 !rounded-xl">
              <div class="text-xs text-ocean-400 font-medium mb-3">{t['SCM (25 meters)']}</div>
              <div class="flex items-center gap-3">
                <input id="wallSCM" type="range" min="0.2" max="1.0" step="0.01" value="0.40" class="premium-slider flex-1" />
                <div id="wallSCMVal" class="w-14 text-right mono text-sm text-white/80">0.40s</div>
              </div>
            </div>

            <div class="glass-card !bg-white/5 p-4 !rounded-xl">
              <div class="text-xs text-ocean-400 font-medium mb-3">{t['LCM (50 meters)']}</div>
              <div class="flex items-center gap-3">
                <input id="wallLCM" type="range" min="0.2" max="1.0" step="0.01" value="0.25" class="premium-slider flex-1" />
                <div id="wallLCMVal" class="w-14 text-right mono text-sm text-white/80">0.25s</div>
              </div>
            </div>
          </div>

          <p class="text-xs text-white/40 mt-4 leading-relaxed">
            {t['Model: remove wall gains from your source swim to estimate free-water speed, then reapply gains for the target course. Outputs are estimates.']}
          </p>
        </div>
      </div>
    </section>

    <!-- Sidebar - Result + Pool Visualization -->
    <aside class="space-y-6 animate-slideInRight" style="animation-delay: 0.2s;">
      <!-- Result Card -->
      <div class="result-card p-6 text-center">
        <div class="text-ocean-400 font-semibold text-sm uppercase tracking-wider mb-4">{t['Converted Result']}</div>
        <div id="resultTime" class="text-4xl md:text-5xl font-bold text-white mono result-glow">—</div>
        <div id="resultMeta" class="text-sm text-white/50 mt-2">—</div>
        
        <div class="h-px bg-gradient-to-r from-transparent via-white/20 to-transparent my-5"></div>
        
        <div class="space-y-3 text-sm">
          <div class="flex items-center justify-between px-2">
            <span class="text-white/60">{t['Pace / 100 m']}</span>
            <span id="pace100m" class="mono text-ocean-400 font-medium">—</span>
          </div>
          <div class="flex items-center justify-between px-2">
            <span class="text-white/60">{t['Pace / 100 yd']}</span>
            <span id="pace100y" class="mono text-ocean-400 font-medium">—</span>
          </div>
        </div>
      </div>

      <!-- Pool Visualization - Enhanced Premium Design -->
      <div class="glass-card p-5 overflow-hidden">
        <div class="flex items-center justify-between mb-4">
          <div class="text-ocean-400 font-semibold text-sm uppercase tracking-wider">Pool Visualization</div>
          <div id="poolCourseLabel" class="text-xs text-white/50 mono bg-white/5 px-2 py-1 rounded">SCY to LCM</div>
        </div>
        
        <!-- Pool Animation Container -->
        <div class="relative bg-gradient-to-b from-ocean-900/50 to-ocean-950/80 rounded-xl p-4 border border-ocean-700/30">
          <!-- Water Effect Overlay -->
          <div class="absolute inset-0 rounded-xl overflow-hidden pointer-events-none">
            <div class="water-ripple"></div>
          </div>
          
          <!-- Pool Lanes with Swimmer -->
          <div id="poolViz" class="relative space-y-1">
            <div class="pool-lane-premium h-8 relative overflow-hidden">
              <div id="swimmerPosition" class="absolute top-1/2 -translate-y-1/2 transition-all duration-700 ease-out" style="left: 10%;">
                <div class="relative">
                  <div class="swimmer-glow"></div>
                  <svg class="w-6 h-6 text-ocean-300 relative z-10" fill="currentColor" viewBox="0 0 24 24">
                    <circle cx="12" cy="3" r="2.5"/>
                    <path d="M4 18c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2v-1l-4-1.5v-1l4-2V9c0-1.1-.9-2-2-2h-4c-1.1 0-2 .9-2 2v3.5l4 2v1l-4 1.5v1H6c-1.1 0-2-.9-2-2v1z"/>
                  </svg>
                </div>
              </div>
              <!-- Lane markers -->
              <div class="absolute inset-0 flex items-center justify-between px-2 pointer-events-none">
                <div class="w-1 h-full bg-gradient-to-b from-ocean-400/50 via-ocean-400/20 to-ocean-400/50"></div>
                <div class="flex-1 border-b-2 border-dashed border-white/10 mx-2"></div>
                <div class="w-1 h-full bg-gradient-to-b from-ocean-400/50 via-ocean-400/20 to-ocean-400/50"></div>
              </div>
            </div>
            <div class="pool-lane-premium h-8"></div>
            <div class="pool-lane-premium h-8"></div>
          </div>
          
          <!-- Pool Distance Markers -->
          <div class="flex justify-between mt-4 text-xs text-white/60 mono relative z-10">
            <div class="flex flex-col items-center">
              <div class="w-0.5 h-3 bg-ocean-500/50 mb-1"></div>
              <span>0</span>
            </div>
            <div id="poolDistanceInfo" class="text-center">
              <span class="text-ocean-400 font-medium" id="poolTotalLaps">4 laps</span>
              <span class="text-white/40 mx-1">•</span>
              <span id="poolTotalDist">100m</span>
            </div>
            <div class="flex flex-col items-center">
              <div class="w-0.5 h-3 bg-ocean-500/50 mb-1"></div>
              <span id="poolLength">25yd</span>
            </div>
          </div>
        </div>
        
        <!-- Pool Stats -->
        <div class="grid grid-cols-2 gap-3 mt-4">
          <div class="bg-white/5 rounded-lg p-3 text-center">
            <div class="text-xs text-white/50 mb-1">Walls</div>
            <div id="poolWalls" class="text-lg font-bold text-ocean-400 mono">—</div>
          </div>
          <div class="bg-white/5 rounded-lg p-3 text-center">
            <div class="text-xs text-white/50 mb-1">Speed</div>
            <div id="poolSpeed" class="text-lg font-bold text-ocean-400 mono">—</div>
          </div>
        </div>
      </div>
    </aside>
  </div>

  <!-- Full Width Quick Reference -->
  <div class="glass-card mt-8 p-6 md:p-8 animate-fadeIn" style="animation-delay: 0.25s;">
    <div class="flex items-center justify-between mb-6">
      <h3 class="text-xl font-bold gradient-text">{t['Quick Reference']}</h3>
      <div class="text-xs text-white/40 hidden md:block">Conversion guidelines</div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="glass-card !bg-white/5 p-4 !rounded-xl border-l-2 border-ocean-500">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-ocean-400 text-lg">→</span>
          <span class="mono text-white font-semibold">{t['SCY→LCM:']}</span>
        </div>
        <p class="text-sm text-white/60">{t['typically adds more time (fewer walls).']}</p>
      </div>
      <div class="glass-card !bg-white/5 p-4 !rounded-xl border-l-2 border-ocean-500">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-ocean-400 text-lg">→</span>
          <span class="mono text-white font-semibold">{t['SCY→SCM:']}</span>
        </div>
        <p class="text-sm text-white/60">{t['smaller increase vs LCM.']}</p>
      </div>
      <div class="glass-card !bg-white/5 p-4 !rounded-xl border-l-2 border-ocean-500">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-ocean-400 text-lg">→</span>
          <span class="mono text-white font-semibold">{t['LCM→SCY:']}</span>
        </div>
        <p class="text-sm text-white/60">{t['often faster due to more walls.']}</p>
      </div>
      <div class="glass-card !bg-white/5 p-4 !rounded-xl border-l-2 border-gold-500">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-gold-400 text-lg">★</span>
          <span class="text-white font-semibold">Pro Tip</span>
        </div>
        <p class="text-sm text-white/60">{t['Tune sliders to match your turn advantage.']}</p>
      </div>
    </div>
    <p class="mt-6 text-xs text-white/40 text-center border-t border-white/10 pt-4">{t['These are estimates, not official conversions.']}</p>
  </div>

  <!-- Time Swim Converter Calculators Section -->
  <div class="glass-card mt-8 p-6 md:p-8 animate-fadeIn" style="animation-delay: 0.28s;">
    <div class="flex items-center justify-between mb-6">
      <h3 class="text-xl font-bold gradient-text">Time Swim Converter Calculators</h3>
      <div class="text-xs text-white/40 hidden md:block">Dedicated tools for specific conversions</div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
      <!-- UK -->
      <a href="/uk-swim-converter/" class="glass-card !bg-white/5 p-4 !rounded-xl hover:!bg-white/10 transition-all duration-300 group hover:scale-[1.02] hover:shadow-lg hover:shadow-ocean-500/10 block no-underline">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 rounded-lg bg-ocean-600/20 border border-ocean-500/30 flex items-center justify-center group-hover:bg-ocean-600/30 transition-colors flex-shrink-0">
            <svg class="w-5 h-5 text-ocean-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21V3h18v18H3zm3-3h12M6 9h12M6 15h12"/></svg>
          </div>
          <div class="font-semibold text-white text-sm group-hover:text-ocean-300 transition-colors">UK Converter</div>
        </div>
        <p class="text-xs text-white/50 leading-relaxed">SCM ⇄ LCM for UK pool formats & Swim England events.</p>
      </a>
      <!-- USA -->
      <a href="/swim-time-usa/" class="glass-card !bg-white/5 p-4 !rounded-xl hover:!bg-white/10 transition-all duration-300 group hover:scale-[1.02] hover:shadow-lg hover:shadow-ocean-500/10 block no-underline">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 rounded-lg bg-ocean-600/20 border border-ocean-500/30 flex items-center justify-center group-hover:bg-ocean-600/30 transition-colors flex-shrink-0">
            <svg class="w-5 h-5 text-ocean-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v18M12 3v18M19 3v18M3 7h18M3 12h18M3 17h18"/></svg>
          </div>
          <div class="font-semibold text-white text-sm group-hover:text-ocean-300 transition-colors">USA Converter</div>
        </div>
        <p class="text-xs text-white/50 leading-relaxed">SCY ⇄ LCM for NCAA, USA Swimming & recruiting.</p>
      </a>
      <!-- LCM to SCY -->
      <a href="/lcm-to-scy/" class="glass-card !bg-white/5 p-4 !rounded-xl hover:!bg-white/10 transition-all duration-300 group hover:scale-[1.02] hover:shadow-lg hover:shadow-ocean-500/10 block no-underline">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 rounded-lg bg-ocean-600/20 border border-ocean-500/30 flex items-center justify-center group-hover:bg-ocean-600/30 transition-colors flex-shrink-0">
            <svg class="w-5 h-5 text-ocean-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </div>
          <div class="font-semibold text-white text-sm group-hover:text-ocean-300 transition-colors">LCM  to SCY</div>
        </div>
        <p class="text-xs text-white/50 leading-relaxed">Long course metres to short course yards.</p>
      </a>
      <!-- SCM to SCY -->
      <a href="/scm-to-scy/" class="glass-card !bg-white/5 p-4 !rounded-xl hover:!bg-white/10 transition-all duration-300 group hover:scale-[1.02] hover:shadow-lg hover:shadow-ocean-500/10 block no-underline">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 rounded-lg bg-ocean-600/20 border border-ocean-500/30 flex items-center justify-center group-hover:bg-ocean-600/30 transition-colors flex-shrink-0">
            <svg class="w-5 h-5 text-ocean-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12M8 12h12M8 17h12M4 7h.01M4 12h.01M4 17h.01"/></svg>
          </div>
          <div class="font-semibold text-white text-sm group-hover:text-ocean-300 transition-colors">SCM to SCY</div>
        </div>
        <p class="text-xs text-white/50 leading-relaxed">Short course metres to short course yards.</p>
      </a>
      <!-- SCY to LCM -->
      <a href="/scy-to-lcm/" class="glass-card !bg-white/5 p-4 !rounded-xl hover:!bg-white/10 transition-all duration-300 group hover:scale-[1.02] hover:shadow-lg hover:shadow-ocean-500/10 block no-underline">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 rounded-lg bg-ocean-600/20 border border-ocean-500/30 flex items-center justify-center group-hover:bg-ocean-600/30 transition-colors flex-shrink-0">
            <svg class="w-5 h-5 text-ocean-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"/></svg>
          </div>
          <div class="font-semibold text-white text-sm group-hover:text-ocean-300 transition-colors">SCY to LCM</div>
        </div>
        <p class="text-xs text-white/50 leading-relaxed">Short course yards to Olympic long course.</p>
      </a>
      <!-- Split Calculator -->
      <a href="/split-calculator/" class="glass-card !bg-white/5 p-4 !rounded-xl hover:!bg-white/10 transition-all duration-300 group hover:scale-[1.02] hover:shadow-lg hover:shadow-ocean-500/10 block no-underline">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 rounded-lg bg-gold-500/20 border border-gold-500/30 flex items-center justify-center group-hover:bg-gold-500/30 transition-colors flex-shrink-0">
            <svg class="w-5 h-5 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div class="font-semibold text-white text-sm group-hover:text-gold-300 transition-colors">Split Calculator</div>
        </div>
        <p class="text-xs text-white/50 leading-relaxed">Even, negative & descending lap splits.</p>
      </a>
      <!-- Yards to Meters -->
      <a href="/yards-to-meters/" class="glass-card !bg-white/5 p-4 !rounded-xl hover:!bg-white/10 transition-all duration-300 group hover:scale-[1.02] hover:shadow-lg hover:shadow-ocean-500/10 block no-underline">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 rounded-lg bg-ocean-600/20 border border-ocean-500/30 flex items-center justify-center group-hover:bg-ocean-600/30 transition-colors flex-shrink-0">
            <svg class="w-5 h-5 text-ocean-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4h16v16H4zM4 12h16M12 4v16"/></svg>
          </div>
          <div class="font-semibold text-white text-sm group-hover:text-ocean-300 transition-colors">Yards to Meters</div>
        </div>
        <p class="text-xs text-white/50 leading-relaxed">The fundamental yards-to-metres conversion.</p>
      </a>
    </div>
  </div>

  <!-- How It Works Section -->
  <article class="glass-card mt-8 p-6 md:p-8 animate-fadeIn" style="animation-delay: 0.3s;">
    <h2 class="text-xl md:text-2xl font-bold gradient-text mb-4">{t['How the Swim Time Converter Works']}</h2>
    <ol class="text-white/70 space-y-3 list-none">
      <li class="flex items-start gap-3">
        <span class="flex-shrink-0 w-7 h-7 rounded-full bg-ocean-600/30 border border-ocean-500/50 flex items-center justify-center text-ocean-400 text-sm font-bold">1</span>
        <span class="pt-0.5">{t['We parse your source time and event to get distance and course.']}</span>
      </li>
      <li class="flex items-start gap-3">
        <span class="flex-shrink-0 w-7 h-7 rounded-full bg-ocean-600/30 border border-ocean-500/50 flex items-center justify-center text-ocean-400 text-sm font-bold">2</span>
        <span class="pt-0.5">{t['We estimate the number of walls (start + turns) from pool length and distance.']}</span>
      </li>
      <li class="flex items-start gap-3">
        <span class="flex-shrink-0 w-7 h-7 rounded-full bg-ocean-600/30 border border-ocean-500/50 flex items-center justify-center text-ocean-400 text-sm font-bold">3</span>
        <span class="pt-0.5">{t['We subtract a per-wall advantage (adjustable) to estimate your free-water speed (m/s).']}</span>
      </li>
      <li class="flex items-start gap-3">
        <span class="flex-shrink-0 w-7 h-7 rounded-full bg-ocean-600/30 border border-ocean-500/50 flex items-center justify-center text-ocean-400 text-sm font-bold">4</span>
        <span class="pt-0.5">We project that speed to the target event and add the target course's wall gains.</span>
      </li>
    </ol>
