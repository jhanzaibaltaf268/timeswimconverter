    if (!Number.isFinite(inputSeconds) || inputSeconds <= 0) return NaN;

    const COUR = {
      SCY: { poolLenM: 25 * 0.9144, wall: wallGains.SCY },
      SCM: { poolLenM: 25, wall: wallGains.SCM },
      LCM: { poolLenM: 50, wall: wallGains.LCM },
    };

    const fromDistM = eventDistanceMeters(fromCourse, fromEvent);
    const toDistM = eventDistanceMeters(toCourse, toEvent);

    const fromWalls = Math.max(1, Math.round(fromDistM / COUR[fromCourse].poolLenM));
    const toWalls = Math.max(1, Math.round(toDistM / COUR[toCourse].poolLenM));

    const freeTime = Math.max(0.01, inputSeconds - fromWalls * COUR[fromCourse].wall);
    const freeSpeed = fromDistM / freeTime;

    const targetFreeTime = toDistM / freeSpeed;
    return targetFreeTime + toWalls * COUR[toCourse].wall;
  }

  function copyToClipboard(text) {
    const str = String(text);
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(str).catch(function() { fallbackCopy(str); });
    } else {
      fallbackCopy(str);
    }
  }
  function fallbackCopy(text) {
    const ta = document.createElement("textarea");
    ta.value = text;
    ta.style.position = "fixed";
    ta.style.left = "-9999px";
    ta.style.top = "-9999px";
    document.body.appendChild(ta);
    ta.focus();
    ta.select();
    try { document.execCommand("copy"); } catch {}
    document.body.removeChild(ta);
  }

  let fromCourse = "SCY";
  let toCourse = "LCM";
  let fromEvent = 100;
  let toEvent = 100;
  let matchNominal = true;

  let timeIn = "1:00.00";
  let secondsIn = 60;

  let decimals = 2;
  let wallGains = { SCY: 0.55, SCM: 0.4, LCM: 0.25 };

  const $decimals = document.getElementById("decimals");
  const $fromCourse = document.getElementById("fromCourse");
  const $toCourse = document.getElementById("toCourse");
  const $fromEvent = document.getElementById("fromEvent");
  const $toEvent = document.getElementById("toEvent");
  const $matchNominal = document.getElementById("matchNominal");
  const $timeIn = document.getElementById("timeIn");

  const $copyResult = document.getElementById("copyResult");
  const $clearTime = document.getElementById("clearTime");

  const $wallSCY = document.getElementById("wallSCY");
  const $wallSCM = document.getElementById("wallSCM");
  const $wallLCM = document.getElementById("wallLCM");
  const $wallSCYVal = document.getElementById("wallSCYVal");
  const $wallSCMVal = document.getElementById("wallSCMVal");
  const $wallLCMVal = document.getElementById("wallLCMVal");

  const $resultTime = document.getElementById("resultTime");
  const $resultMeta = document.getElementById("resultMeta");
  const $pace100m = document.getElementById("pace100m");
  const $pace100y = document.getElementById("pace100y");

  function eventUnit(course) {
    return course === "SCY" ? "yd" : "m";
  }

  function syncEventOptions(selectEl, course, selectedValue) {
    const list = EVENTS[course] || [];
    selectEl.innerHTML = "";
    for (const ev of list) {
      const opt = document.createElement("option");
      opt.value = String(ev);
      opt.textContent = `${ev} ${eventUnit(course)}`;
      if (Number(ev) === Number(selectedValue)) opt.selected = true;
      selectEl.appendChild(opt);
    }
  }

  function matchToEvent() {
    if (!matchNominal) return;

    const key = `${fromCourse}:${fromEvent}`;
    const map = EQUIV[key];
    const list = EVENTS[toCourse];

    if (map && map[toCourse]) {
      toEvent = map[toCourse];
      return;
    }

    if (list.includes(fromEvent)) {
      toEvent = fromEvent;
      return;
    }

    const fromM = eventDistanceMeters(fromCourse, fromEvent);
    let best = list[0], diff = Infinity;
    for (const ev of list) {
      const mtrs = eventDistanceMeters(toCourse, ev);
      const d = Math.abs(mtrs - fromM);
      if (d < diff) { best = ev; diff = d; }
    }
    toEvent = best;
  }
  
  function updatePoolVisualization(targetSeconds, toDistM) {
    const poolLengths = {
      SCY: "25yd",
      SCM: "25m",
      LCM: "50m"
    };
    
    const poolLengthsM = {
      SCY: 25 * 0.9144,
      SCM: 25,
      LCM: 50
    };
    
    // Update pool length label
    const $poolLength = document.getElementById("poolLength");
    if ($poolLength) {
      $poolLength.textContent = poolLengths[toCourse] || "25m";
    }
    
    // Update course label
    const $poolCourseLabel = document.getElementById("poolCourseLabel");
    if ($poolCourseLabel) {
      $poolCourseLabel.textContent = `${fromCourse} → ${toCourse}`;
    }
    
    // Calculate walls and laps
    const poolLen = poolLengthsM[toCourse] || 25;
    const distM = toDistM || eventDistanceMeters(toCourse, toEvent);
    const laps = Math.max(1, Math.round(distM / poolLen));
    const walls = laps; // Each lap ends at a wall
    
    // Update laps and distance
    const $poolTotalLaps = document.getElementById("poolTotalLaps");
    const $poolTotalDist = document.getElementById("poolTotalDist");
    if ($poolTotalLaps) {
      $poolTotalLaps.textContent = `${laps} lap${laps > 1 ? 's' : ''}`;
    }
    if ($poolTotalDist) {
      const unit = toCourse === "SCY" ? "yd" : "m";
      $poolTotalDist.textContent = `${toEvent}${unit}`;
    }
    
    // Update walls count
    const $poolWalls = document.getElementById("poolWalls");
    if ($poolWalls) {
      $poolWalls.textContent = walls.toString();
    }
    
    // Calculate and update speed
    const $poolSpeed = document.getElementById("poolSpeed");
    if ($poolSpeed && Number.isFinite(targetSeconds) && targetSeconds > 0 && distM > 0) {
      const speedMps = distM / targetSeconds;
      $poolSpeed.textContent = `${speedMps.toFixed(2)} m/s`;
    } else {
      if ($poolSpeed) $poolSpeed.textContent = "—";
    }
    
    // Animate swimmer position based on a cycle (simulating swimming back and forth)
    const $swimmerPosition = document.getElementById("swimmerPosition");
    if ($swimmerPosition) {
      // Create a swimming animation cycle
      const now = Date.now();
      const cycleTime = 3000; // 3 seconds per lap
      const progress = (now % cycleTime) / cycleTime;
      // Swim back and forth: 0->1->0
      const position = progress < 0.5 
        ? 10 + (progress * 2 * 80) // Go right: 10% to 90%
        : 90 - ((progress - 0.5) * 2 * 80); // Go left: 90% to 10%
      $swimmerPosition.style.left = `${position}%`;
    }
  }

  function computeAndRender() {
    secondsIn = parseTimeToSeconds(timeIn);

    if (matchNominal) matchToEvent();

    syncEventOptions($fromEvent, fromCourse, fromEvent);
    syncEventOptions($toEvent, toCourse, toEvent);

    const targetSeconds = convertTime({
      fromCourse,
      toCourse,
      fromEvent,
      toEvent,
      inputSeconds: secondsIn,
      wallGains,
    });

    const toDistM = eventDistanceMeters(toCourse, toEvent);
    
    // Update pool visualization with calculated data
    updatePoolVisualization(targetSeconds, toDistM);

    const pacePer100M = Number.isFinite(targetSeconds) && toDistM > 0
      ? targetSeconds / (toDistM / 100)
      : NaN;

    const pacePer100Y = (() => {
      if (!Number.isFinite(targetSeconds)) return NaN;
      const yardsTotal = toCourse === "SCY" ? toEvent : (toDistM / 0.9144);
      return targetSeconds / (yardsTotal / 100);
    })();

    $wallSCYVal.textContent = `${fmtNum(wallGains.SCY, 2)}s`;
    $wallSCMVal.textContent = `${fmtNum(wallGains.SCM, 2)}s`;
    $wallLCMVal.textContent = `${fmtNum(wallGains.LCM, 2)}s`;

    $resultTime.textContent = Number.isFinite(targetSeconds) ? formatSeconds(targetSeconds, decimals) : "—";

    const courseLabel =
      ({ SCY: t['SCY (25 yards)'], SCM: t['SCM (25 meters)'], LCM: t['LCM (50 meters)'] }[toCourse]) || toCourse;

    $resultMeta.textContent = `${toEvent} ${eventUnit(toCourse)} • ${courseLabel}`;

    $pace100m.textContent = Number.isFinite(pacePer100M) ? formatSeconds(pacePer100M, decimals) : "—";
    $pace100y.textContent = Number.isFinite(pacePer100Y) ? formatSeconds(pacePer100Y, decimals) : "—";

    $timeIn.value = timeIn;
    $decimals.value = String(decimals);
    $fromCourse.value = fromCourse;
    $toCourse.value = toCourse;
    $matchNominal.checked = !!matchNominal;

    computeAndRender._last = { targetSeconds };
  }

  $decimals.addEventListener("change", (e) => {
    decimals = clamp(Number(e.target.value), 0, 3);
    computeAndRender();
  });

  $fromCourse.addEventListener("change", (e) => {
    fromCourse = e.target.value;
    const list = EVENTS[fromCourse] || [];
    if (!list.includes(fromEvent)) fromEvent = list[1] || list[0] || 100;
    computeAndRender();
  });

  $toCourse.addEventListener("change", (e) => {
    toCourse = e.target.value;
    const list = EVENTS[toCourse] || [];
    if (!list.includes(toEvent)) toEvent = list[1] || list[0] || 100;
    computeAndRender();
  });

  $fromEvent.addEventListener("change", (e) => {
    fromEvent = Number(e.target.value);
    computeAndRender();
  });

  $toEvent.addEventListener("change", (e) => {
    toEvent = Number(e.target.value);
    computeAndRender();
  });

  $matchNominal.addEventListener("change", (e) => {
    matchNominal = !!e.target.checked;
    computeAndRender();
  });

  $timeIn.addEventListener("input", (e) => {
    timeIn = e.target.value;
    computeAndRender();
  });

  $wallSCY.addEventListener("input", (e) => {
    wallGains.SCY = Number(e.target.value);
    computeAndRender();
  });
  $wallSCM.addEventListener("input", (e) => {
    wallGains.SCM = Number(e.target.value);
    computeAndRender();
  });
  $wallLCM.addEventListener("input", (e) => {
    wallGains.LCM = Number(e.target.value);
    computeAndRender();
  });

  $copyResult.addEventListener("click", () => {
    const last = computeAndRender._last || {};
    const tt = last.targetSeconds;
    if (Number.isFinite(tt)) {
      copyToClipboard(formatSeconds(tt, decimals));
      const origHTML = $copyResult.innerHTML;
      $copyResult.innerHTML = '<span class="flex items-center gap-2"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>Copied!</span>';
      setTimeout(() => { $copyResult.innerHTML = origHTML; }, 1500);
    }
  });

  $clearTime.addEventListener("click", () => {
    timeIn = "";
    computeAndRender();
  });

  syncEventOptions($fromEvent, fromCourse, fromEvent);
  syncEventOptions($toEvent, toCourse, toEvent);
  $timeIn.value = timeIn;

  $wallSCY.value = String(wallGains.SCY);
  $wallSCM.value = String(wallGains.SCM);
  $wallLCM.value = String(wallGains.LCM);

  // Set default selections
  $decimals.value = "2";
  $matchNominal.checked = true;

  computeAndRender();
</script>

  <Chart title={t['Table']} data={chartData} />
  <FAQs faqs={t.faqs} />
  <CalculatorToolsBanner />
  <RelatedResources />
</IndexLayout>
