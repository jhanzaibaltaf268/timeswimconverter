---
import { getTranslations, getLocaleFromUrl, getLocalizedUrl } from '@theme/i18n/utils';
import LanguageSwitcher from '@theme/components/LanguageSwitcher.astro';

import config from '~/config/config.json';
import navigation from '~/config/navigation.json';

import Facebook from './SVGs/Facebook.astro';
import Linkedin from './SVGs/Linkedin.astro';
import Twitter from './SVGs/Twitter.astro';
import Pinterest from './SVGs/Pinterest.astro';

import ExploreMoreTools from './ExploreMoreTools.astro';

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);

const socialLogos : Record<string, any> = {
  facebook: Facebook,
  linkedin: Linkedin,
  twitter: Twitter,
  pinterest: Pinterest,
};

const getSocialLogoMarkup = (name: string) => socialLogos[name.toLowerCase()] ?? null;
---

<footer class="relative z-10 mt-8 md:mt-12">
  <!-- Top gradient line -->
  <div class="h-px bg-gradient-to-r from-transparent via-ocean-500/50 to-transparent"></div>
  
  <div class="glass-card-strong !rounded-none !border-x-0 !border-b-0">
    <div class="mx-auto max-w-6xl px-6 pt-10 pb-6">
      
      <!-- ═══ Top Section: 4-Column Grid ═══ -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10">
        
        <!-- Col 1: Logo, Description & Social -->
        <div>
          <div class="flex items-center gap-3 mb-4">
            <div class="relative group">
              <img src="/images/logo.png" width="48" height="48" alt={(t as any)['Footer Logo'] || 'Footer Logo'} title={(t as any)['Footer Logo'] || 'Footer Logo'} loading="lazy" class="rounded-xl transition-transform duration-300 group-hover:scale-105" />
              <div class="absolute inset-0 rounded-xl bg-gradient-to-br from-ocean-500/20 to-gold-500/10 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            </div>
            <h2 class="font-bold text-lg gradient-text">{t.site_title}</h2>
          </div>
          <p class="text-white/60 text-sm leading-relaxed mb-5">{t.footer_description}</p>
          
          {
            config.social.find((item) => !!item.url) && (
              <ul class="flex gap-3">
                {config.social.map((item) => {
                  if (!item.url) return null;
                  const IconMarkup = getSocialLogoMarkup(item.name);
                  if (!IconMarkup) return null;
                  return (
                    <li>
                      <a 
                        href={item.url} 
                        title={item.name + ' ' + ((t as any)['Logo'] || 'Logo')}
                        class="flex items-center justify-center w-10 h-10 rounded-full bg-ocean-600/25 border border-ocean-500/30 hover:bg-ocean-500/40 hover:border-ocean-400/50 transition-all duration-300 group"
                      >
                        <IconMarkup class="w-4 h-4 text-white/80 group-hover:text-white transition-colors duration-300" />
                      </a>
                    </li>
                  );
                })}
              </ul>
            )
          }
        </div>
        
        <!-- Col 2: Quick Menu -->
        <div>
          <h3 class="font-bold text-white text-sm uppercase tracking-wider mb-5">{(t as any)['Quick Menu'] || 'Quick Menu'}</h3>
          <ul class="space-y-3">
            {
              navigation.footer_quick.map((item) => (
                <li>
                  <a 
                    href={getLocalizedUrl(item.url, locale)}
                    class="text-white/60 hover:text-ocean-300 text-sm transition-colors duration-300 flex items-center gap-2.5 group"
                  >
                    <span class="w-1.5 h-1.5 rounded-full bg-ocean-500/50 group-hover:bg-ocean-400 transition-colors"></span>
                    {(t as any)[item.name] || item.name}
                  </a>
                </li>
              ))
            }
            <!-- Calculators inline -->
            <li><a href={getLocalizedUrl('/uk-swim-converter/', locale)} class="text-white/60 hover:text-ocean-300 text-sm transition-colors duration-300 flex items-center gap-2.5 group"><span class="w-1.5 h-1.5 rounded-full bg-ocean-500/50 group-hover:bg-ocean-400 transition-colors"></span>UK Converter</a></li>
            <li><a href={getLocalizedUrl('/swim-time-usa/', locale)} class="text-white/60 hover:text-ocean-300 text-sm transition-colors duration-300 flex items-center gap-2.5 group"><span class="w-1.5 h-1.5 rounded-full bg-ocean-500/50 group-hover:bg-ocean-400 transition-colors"></span>USA Converter</a></li>
            <li><a href={getLocalizedUrl('/split-calculator/', locale)} class="text-white/60 hover:text-ocean-300 text-sm transition-colors duration-300 flex items-center gap-2.5 group"><span class="w-1.5 h-1.5 rounded-full bg-ocean-500/50 group-hover:bg-ocean-400 transition-colors"></span>Split Calculator</a></li>
          </ul>
        </div>
        
        <!-- Col 3: Calculators -->
        <div>
          <h3 class="font-bold text-white text-sm uppercase tracking-wider mb-5">{(t as any)['Calculators'] || 'Calculators'}</h3>
          <ul class="space-y-3">
            <li><a href={getLocalizedUrl('/lcm-to-scy/', locale)} class="text-white/60 hover:text-ocean-300 text-sm transition-colors duration-300 flex items-center gap-2.5 group"><span class="w-1.5 h-1.5 rounded-full bg-ocean-500/50 group-hover:bg-ocean-400 transition-colors"></span>LCM to SCY</a></li>
            <li><a href={getLocalizedUrl('/scm-to-scy/', locale)} class="text-white/60 hover:text-ocean-300 text-sm transition-colors duration-300 flex items-center gap-2.5 group"><span class="w-1.5 h-1.5 rounded-full bg-ocean-500/50 group-hover:bg-ocean-400 transition-colors"></span>SCM to SCY</a></li>
            <li><a href={getLocalizedUrl('/scy-to-lcm/', locale)} class="text-white/60 hover:text-ocean-300 text-sm transition-colors duration-300 flex items-center gap-2.5 group"><span class="w-1.5 h-1.5 rounded-full bg-ocean-500/50 group-hover:bg-ocean-400 transition-colors"></span>SCY to LCM</a></li>
            <li><a href={getLocalizedUrl('/yards-to-meters/', locale)} class="text-white/60 hover:text-ocean-300 text-sm transition-colors duration-300 flex items-center gap-2.5 group"><span class="w-1.5 h-1.5 rounded-full bg-ocean-500/50 group-hover:bg-ocean-400 transition-colors"></span>Yards to Meters</a></li>
            {
              navigation.footer_legal.map((item) => (
                <li>
                  <a 
                    href={getLocalizedUrl(item.url, locale)}
                    class="text-white/60 hover:text-ocean-300 text-sm transition-colors duration-300 flex items-center gap-2.5 group"
                  >
                    <span class="w-1.5 h-1.5 rounded-full bg-ocean-500/50 group-hover:bg-ocean-400 transition-colors"></span>
                    {(t as any)[item.name] || item.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        
        <!-- Col 4: Stay Updated -->
        <div>
          <h3 class="font-bold text-white text-sm uppercase tracking-wider mb-5">{(t as any)['Stay Updated'] || 'Stay Updated'}</h3>
          <p class="text-white/50 text-sm leading-relaxed mb-4">{(t as any)['Stay Updated Description'] || 'Stay Updated Description'}</p>
          <form id="newsletter-form" class="space-y-3">
            <div class="relative">
              <input 
                id="newsletter-email"
                type="email" 
                placeholder={(t as any)['Enter your email'] || "Enter your email"} 
                required
                class="w-full px-4 py-2.5 rounded-lg bg-white/8 border border-white/15 text-white text-sm placeholder-white/30 focus:outline-none focus:border-ocean-500/50 focus:bg-white/10 transition-all duration-300"
              />
              <p id="newsletter-error" class="hidden text-red-400 text-[10px] mt-1 ml-1 animate-fadeIn">{(t as any)['Invalid Email'] || 'Invalid Email'}</p>
            </div>
            <button 
              id="newsletter-submit"
              type="submit" 
              class="w-full px-4 py-2.5 rounded-lg bg-ocean-600 hover:bg-ocean-500 text-white font-semibold text-sm transition-all duration-300 hover:shadow-lg hover:shadow-ocean-500/25 flex items-center justify-center gap-2 group"
            >
              <span>{(t as any)['Subscribe'] || 'Subscribe'}</span>
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </button>
          </form>

          <!-- Success Message -->
          <div id="newsletter-success" class="hidden animate-fadeIn p-4 rounded-xl bg-ocean-500/10 border border-ocean-500/20 text-center">
            <div class="w-10 h-10 rounded-full bg-ocean-500/20 flex items-center justify-center mx-auto mb-3">
              <svg class="w-6 h-6 text-ocean-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
            </div>
            <p class="text-white font-medium text-sm">{(t as any)['Subscribe Thank You'] || 'Subscribe Thank You'}</p>
          </div>

        </div>
      </div>
      
      <!-- ═══ Explore More Tools Section ═══ -->
      <ExploreMoreTools />

      <!-- ═══ Bottom Bar: Copyright + Languages ═══ -->
      <div class="mt-6 pt-6 border-t border-white/10 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-5">
        <!-- Copyright -->
        <p class="text-white/50 text-xs shrink-0">
          &copy; {new Date().getFullYear()} <strong class="text-white/70">{t.site_title}</strong>. {(t as any)['All rights reserved'] || 'All rights reserved'}.
          <span class="hidden sm:inline ml-2">Built with ❤️ by <a href="https://www.shahabdev.com/" target="_blank" rel="noopener noreferrer" class="gradient-text-gold font-semibold hover:underline">Shahab Dev</a>.</span>
        </p>
        
        <!-- Language Switcher -->
        <LanguageSwitcher />
      </div>
    </div>
  </div>
</footer>

<!-- Scroll To Top Button -->
<button
  id="scrollToTopBtn"
  title="Scroll to top"
  class="fixed bottom-6 right-6 z-50 w-11 h-11 rounded-full bg-ocean-600/80 border border-ocean-500/40 backdrop-blur-md text-white shadow-lg shadow-ocean-500/20 flex items-center justify-center opacity-0 pointer-events-none translate-y-4 transition-all duration-300 hover:bg-ocean-500 hover:scale-110 hover:shadow-ocean-500/40 cursor-pointer"
  aria-label="Scroll to top"
>
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/>
  </svg>
</button>

<script>
  const scrollBtn = document.getElementById('scrollToTopBtn');
  if (scrollBtn) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 400) {
        scrollBtn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
        scrollBtn.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
      } else {
        scrollBtn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
        scrollBtn.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
      }
    });
    scrollBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  // Newsletter Form Handling
  const form = document.getElementById('newsletter-form') as HTMLFormElement;
  const emailInput = document.getElementById('newsletter-email') as HTMLInputElement;
  const submitBtn = document.getElementById('newsletter-submit') as HTMLButtonElement;
  const successMsg = document.getElementById('newsletter-success');
  const errorMsg = document.getElementById('newsletter-error');

  if (form && emailInput && submitBtn && successMsg && errorMsg) {
    const validateEmail = (email: string) => {
      return String(email)
        .toLowerCase()
        .match(
          /^(([^<>()[\]\\.,;:\s@"]+(\.[^<>()[\]\\.,;:\s@"]+)*)|(".+"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/
        );
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const email = emailInput.value.trim();
      
      // Reset state
      errorMsg.classList.add('hidden');
      
      if (!validateEmail(email)) {
        errorMsg.classList.remove('hidden');
        return;
      }

      // Simulate API call
      submitBtn.disabled = true;
      const originalText = submitBtn.innerHTML;
      submitBtn.innerHTML = '<svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>';

      // Mock delay
      await new Promise(resolve => setTimeout(resolve, 1000));

      // Success!
      form.classList.add('hidden');
      successMsg.classList.remove('hidden');
      
      // Reset for potential next time (optional, usually you don't reshow it)
      // submitBtn.disabled = false;
      // submitBtn.innerHTML = originalText;
      // emailInput.value = '';
    });

    // Hide error on input
    emailInput.addEventListener('input', () => {
      errorMsg.classList.add('hidden');
    });
  }

</script>
