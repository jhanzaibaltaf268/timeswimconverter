---
// theme/components/AdsterraBanner.astro

interface Props {
  type?: 'banner468' | 'banner728' | 'native';
}

const { type = 'banner468' } = Astro.props;
---

{type === 'banner468' && (
  <div class="my-6 flex flex-col items-center justify-center overflow-hidden text-center min-h-[60px] animate-fadeIn">
    <div class="text-[10px] text-white/40 uppercase tracking-widest mb-1 select-none">Advertisement</div>
    <div class="glass-card p-2 inline-block max-w-full overflow-x-auto">
      <script is:inline>
        atOptions = {
          'key' : '18d108ed8650e16474e203a5354e3e66',
          'format' : 'iframe',
          'height' : 60,
          'width' : 468,
          'params' : {}
        };
      </script>
      <script is:inline src="https://www.highrevenueformat.com/18d108ed8650e16474e203a5354e3e66/invoke.js"></script>
    </div>
  </div>
)}

{type === 'banner728' && (
  <div class="my-6 flex flex-col items-center justify-center overflow-hidden text-center min-h-[90px] animate-fadeIn">
    <div class="text-[10px] text-white/40 uppercase tracking-widest mb-1 select-none">Advertisement</div>
    <div class="glass-card p-2 inline-block max-w-full overflow-x-auto">
      <script is:inline>
        atOptions = {
          'key' : '18d108ed8650e16474e203a5354e3e66',
          'format' : 'iframe',
          'height' : 60,
          'width' : 468,
          'params' : {}
        };
      </script>
      <script is:inline src="https://www.highrevenueformat.com/18d108ed8650e16474e203a5354e3e66/invoke.js"></script>
    </div>
  </div>
)}

{type === 'native' && (
  <div class="my-6 flex flex-col items-center justify-center overflow-hidden text-center animate-fadeIn">
    <div class="text-[10px] text-white/40 uppercase tracking-widest mb-1 select-none">Advertisement</div>
    <div class="glass-card p-2 w-full max-w-4xl overflow-x-auto flex justify-center">
      <script is:inline async="async" data-cfasync="false" src="https://pl30497499.profitableratecpmnetwork.com/e7eaa2b65a1508f236eecf0ffb226345/invoke.js"></script>
      <div id="container-e7eaa2b65a1508f236eecf0ffb226345"></div>
    </div>
  </div>
)}

